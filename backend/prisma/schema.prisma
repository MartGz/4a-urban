generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        Int         @id @default(autoincrement())
  nombre    String
  precio    Float
  talla     String
  imageUrl  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  orderItems OrderItem[]
}

model Role {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  description  String?
  isSystem     Boolean  @default(false) // SUPER_ADMIN y CUSTOMER: no se pueden borrar
  isSuperAdmin Boolean  @default(false) // bypassa cualquier chequeo de permiso
  permissions  String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?  // Opcional para Google Login
  googleId  String?  @unique
  name      String?
  phone     String?
  birthday  DateTime?
  documentId String?   // Documento de Identidad (CC, TI, etc.)
  jobTitle  String?    // Campo corporativo para Admin
  resetCode String?    // Código para cambio de clave
  resetCodeExpires DateTime?
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])
  inviteToken        String?
  inviteTokenExpires DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Carousel {
  id        Int            @id @default(autoincrement())
  slug      String         @unique
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  images    GalleryImage[]
}

model GalleryImage {
  id         Int      @id @default(autoincrement())
  carouselId Int
  carousel   Carousel @relation(fields: [carouselId], references: [id], onDelete: Cascade)
  data       Bytes
  mimeType   String
  caption    String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
}

model Order {
  id                 Int         @id @default(autoincrement())
  userId             Int
  user               User        @relation(fields: [userId], references: [id])
  total              Float
  status             String      @default("PENDING") // PENDING, SHIPPED, COMPLETED, CANCELLED
  trackingNumber     String?     // Número de guía
  emailSent          Boolean     @default(false)
  lastNotificationAt DateTime?   
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  items              OrderItem[]
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}
